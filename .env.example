# TradeNova Environment Variables Template

# Gemini API Key for AI Analysis & Stock Research
# In Google AI Studio, this is injected automatically from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/tradenova?retryWrites=true&w=majority
# If not provided, TradeNova gracefully operates with a local persistent memory store
MONGODB_URI=""

# Authentication Secret for signing JWT tokens and session security
JWT_SECRET="tradenova_super_secret_jwt_key_development_2026_xyz"

# Market Data Provider: 'DEMO' | 'TRUEDATA' | 'KITE' | 'YAHOO' | 'NSE_DIRECT'
MARKET_DATA_PROVIDER="DEMO"
MARKET_DATA_API_KEY=""
MARKET_DATA_API_SECRET=""
MARKET_DATA_BASE_URL=""

# News API Key for financial news retrieval (optional)
NEWS_API_KEY=""

# Application Host URL
APP_URL="http://localhost:3000"

# Runtime Environment
NODE_ENV="development"
